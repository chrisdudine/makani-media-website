{
  "name": "makani-media-website",
  "private": true,
  "scripts": {
    "format": "prettier --write \"*.html\" \"assets/**/*.{css,js}\" \"worker/src/**/*.js\" \"tests/*.{js,mjs}\" \"*.md\" \"docs/*.md\" \"*.json\"",
    "format:check": "prettier --check \"*.html\" \"assets/**/*.{css,js}\" \"worker/src/**/*.js\" \"tests/*.{js,mjs}\" \"*.md\" \"docs/*.md\" \"*.json\"",
    "test": "node --test tests/source.test.mjs tests/worker.test.mjs tests/booking-email.test.mjs tests/estimate.test.mjs tests/gemini.test.mjs",
    "test:browser": "node tests/serve.mjs",
    "test:crm-runtime": "node tests/gemini-runtime.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "wrangler": "4.141.0"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
